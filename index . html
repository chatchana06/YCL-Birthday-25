    /* Candle flame animation - slow, smooth and natural */
    @keyframes flameWiggle {
      0%, 100% { transform: scale(1) rotate(-1deg); }
      50% { transform: scale(1.02, 1.04) rotate(1.2deg); }
    }
    .flame-anim {
      animation: flameWiggle 2.2s ease-in-out infinite alternate;
      transform-origin: bottom center;
    }

    /* Backpack pulse */
    @keyframes pulseGlow {
      0%, 100% { filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.4)); transform: scale(1); }
      50% { filter: drop-shadow(0 0 16px rgba(59, 130, 246, 0.9)); transform: scale(1.06); }
    }
    .backpack-highlight {
      animation: pulseGlow 1.2s infinite ease-in-out;
    }

    /* Pop in animation */
    .pop-in {
      animation: popIn 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.3) translateY(20px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* Envelope Letter slide up */
    .letter-slide-up {
      animation: letterUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes letterUp {
      0% { transform: translateY(80px) scale(0.9); opacity: 0; }
      100% { transform: translateY(0) scale(1); opacity: 1; }
    }
