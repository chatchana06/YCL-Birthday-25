        document.getElementById("tray-berry-4").style.transform = "scale(0)";
        titleEl.textContent = "Yay, just one more strawberry!";
      } else if (step === 5) {
        document.getElementById("cake-berry-5").classList.remove("hidden");
        document.getElementById("cake-berry-5").classList.add("pop-in");
        document.getElementById("tray-berry-5").style.opacity = "0";
        document.getElementById("tray-berry-5").style.transform = "scale(0)";
        titleEl.textContent = "Now tap to place the candle!";
      } else if (step === 6) {
        // Place Candle & Lit
        document.getElementById("cake-candle").classList.remove("hidden");
        document.getElementById("cake-candle").classList.add("pop-in");
        document.getElementById("source-candle").style.opacity = "0";
        titleEl.textContent = "Enjoy the birthday song! 🎶";

        // Play Full Happy Birthday Song!
        playHappyBirthdaySong();

        // Confetti burst
        confetti({
          particleCount: 50,
          spread: 60,
          origin: { y: 0.6 }
        });

        // Hide bottom pile container completely after a short delay
        setTimeout(() => {
          sourcePile.classList.add("hidden");
        }, 300);
      }
    }

    function blowOutCandle() {
      if (candleBlownOut || step < 6) return;
      candleBlownOut = true;
      stopMicrophoneBlowDetection();

      // Hide flame, show smoke
      document.getElementById("candle-flame").classList.add("hidden");
      document.getElementById("candle-smoke").classList.remove("hidden");
      
      // Show Age 25 Banner
      document.getElementById("age-banner").classList.remove("hidden");

      titleEl.textContent = "Wish granted! Make a wonderful year ahead ✨💖";
      titleEl.classList.remove("animate-pulse");
      
      // Play chimes and applause!
      playChime(300, 'sawtooth');
      playApplauseSound();

      // Big celebratory confetti for blowing candle
      confetti({
        particleCount: 100,
        spread: 100,
        origin: { y: 0.5 }
      });

      // Shinchan appears right AFTER the applause sound finishes (approx 2.5 seconds later)
      setTimeout(() => {
        playChime(850, 'triangle');
        shinchanContainer.classList.remove("hidden");
        shinchanContainer.classList.add("pop-in");

        // Transition speech after 2 seconds
        setTimeout(() => {
          document.getElementById("shinchan-star-eyes").classList.add("hidden");
          shinchanSpeech.textContent = "Nepjune has a gift for you! 🎁 Tap my backpack!";
          shinchanBackpack.classList.add("backpack-highlight");
          document.getElementById("backpack-tap-hint").classList.remove("hidden");
        }, 2000);
      }, 2600);
    }

    function handleShinchanClick() {
      // Open Letter modal
      playChime(950, 'triangle');
      loveLetterModal.classList.remove("hidden");
      
      // Large Celebration Confetti
      confetti({
        particleCount: 120,
        spread: 80,
        origin: { y: 0.5 }
      });
    }

    function closeLetter() {
      loveLetterModal.classList.add("hidden");
    }

    function restartSurprise() {
      stopMicrophoneBlowDetection();
      playChime(600, 'sine');

      // Reset variables
      enteredPin = "";
      wrongPinAttempts = 0;
      step = 0;
      candleBlownOut = false;

      // Reset PIN Screen UI
      updatePinDisplay();
      document.getElementById("pin-error").textContent = "";
      document.getElementById("pin-modal").classList.remove("hidden");
      document.getElementById("intro-modal").classList.add("hidden");
      loveLetterModal.classList.add("hidden");

      // Reset Cake & Strawberries UI
      for (let i = 1; i <= 5; i++) {
        const cakeBerry = document.getElementById("cake-berry-" + i);
        cakeBerry.classList.add("hidden");
        cakeBerry.classList.remove("pop-in");

        const trayBerry = document.getElementById("tray-berry-" + i);
        trayBerry.style.opacity = "1";
        trayBerry.style.transform = "";
      }

      // Reset Candle & Flame UI
      const cakeCandle = document.getElementById("cake-candle");
      cakeCandle.classList.add("hidden");
      cakeCandle.classList.remove("pop-in");
      document.getElementById("source-candle").style.opacity = "1";
      document.getElementById("candle-flame").classList.remove("hidden");
      document.getElementById("candle-smoke").classList.add("hidden");
      document.getElementById("age-banner").classList.add("hidden");

      // Reset Bottom Tray & Title
      sourcePile.classList.remove("hidden");
      titleEl.textContent = "Decorate the cake! 🍓";
      titleEl.classList.remove("animate-pulse");

      // Reset Shinchan UI
      shinchanContainer.classList.add("hidden");
      shinchanContainer.classList.remove("pop-in");
      document.getElementById("shinchan-star-eyes").classList.remove("hidden");
      shinchanSpeech.textContent = "Woohoo! So amazing!! ✨";
      shinchanBackpack.classList.remove("backpack-highlight");
      document.getElementById("backpack-tap-hint").classList.add("hidden");
    }
  </script>
</body>
</html>
