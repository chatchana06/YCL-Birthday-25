  <script>
    let enteredPin = "";
    const correctPin = "07112026";
    let wrongPinAttempts = 0;

    function pressKey(num) {
      if (enteredPin.length < 8) {
        enteredPin += num;
        updatePinDisplay();
        playChime(500 + enteredPin.length * 50, 'sine');

        if (enteredPin.length === 8) {
          setTimeout(verifyPin, 300);
        }
      }
    }

    function deletePin() {
      if (enteredPin.length > 0) {
        enteredPin = enteredPin.slice(0, -1);
        updatePinDisplay();
        playChime(350, 'sine');
      }
    }

    function clearPin() {
      enteredPin = "";
      updatePinDisplay();
      playChime(300, 'sine');
    }

    function updatePinDisplay() {
      const displayEl = document.getElementById("pin-display");
      let formatted = "";
      for (let i = 0; i < 8; i++) {
        let char = enteredPin[i] || "_";
        formatted += char;
        if (i === 1 || i === 3) formatted += " / ";
      }
      displayEl.textContent = formatted;
    }

    function verifyPin() {
      if (enteredPin === correctPin) {
        playChime(800, 'triangle');
        confetti({ particleCount: 60, spread: 70, origin: { y: 0.5 } });
        document.getElementById("pin-modal").classList.add("hidden");
        document.getElementById("intro-modal").classList.remove("hidden");
      } else {
        wrongPinAttempts++;
        playChime(200, 'sawtooth');
        
        let errorMsg = "Incorrect PIN, please try again! ❌";
        if (wrongPinAttempts >= 2) {
          errorMsg = "Hint: Try 07/11/2026 💡";
        }
        document.getElementById("pin-error").textContent = errorMsg;

        setTimeout(() => {
          enteredPin = "";
          updatePinDisplay();
