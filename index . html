  <!-- Floating Audio Generator (Cute Chimes with Web Audio API) -->
  <script>
    let audioCtx = null;
    let micStream = null;
    let analyser = null;
    let isMicListening = false;

    function initAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playChime(freq = 600, type = 'sine') {
      try {
        initAudioContext();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {}
    }

    // Play Full Happy Birthday Song
    function playHappyBirthdaySong() {
      try {
        initAudioContext();
        const C4 = 261.63, D4 = 293.66, E4 = 329.63, F4 = 349.23, G4 = 392.00, A4 = 440.00, C5 = 523.25;
        const melody = [
          {f: C4, d: 0.25}, {f: C4, d: 0.25}, {f: D4, d: 0.5}, {f: C4, d: 0.5}, {f: F4, d: 0.5}, {f: E4, d: 1.0},
          {f: C4, d: 0.25}, {f: C4, d: 0.25}, {f: D4, d: 0.5}, {f: C4, d: 0.5}, {f: G4, d: 0.5}, {f: F4, d: 1.0},
          {f: C4, d: 0.25}, {f: C4, d: 0.25}, {f: C5, d: 0.5}, {f: A4, d: 0.5}, {f: F4, d: 0.5}, {f: E4, d: 0.5}, {f: D4, d: 1.0},
          {f: A4, d: 0.25}, {f: A4, d: 0.25}, {f: G4, d: 0.5}, {f: F4, d: 0.5}, {f: G4, d: 0.5}, {f: F4, d: 1.2}
        ];

        let currTime = audioCtx.currentTime;
        melody.forEach(note => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(note.f, currTime);
          gain.gain.setValueAtTime(0.15, currTime);
          gain.gain.exponentialRampToValueAtTime(0.001, currTime + note.d * 0.9);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(currTime);
          osc.stop(currTime + note.d);
          currTime += note.d;
        });

        const totalDurationMs = (currTime - audioCtx.currentTime) * 1000;
        setTimeout(() => {
          if (!candleBlownOut) {
            titleEl.textContent = "Make a wish! 🌟🎂 (Blow into mic or tap the flame)";
            titleEl.classList.add("animate-pulse");
            startMicrophoneBlowDetection();
          }
        }, totalDurationMs);
      } catch (e) {}
    }

    // Play Joyful Applause Sound Effect
    function playApplauseSound() {
      try {
        initAudioContext();
        const bufferSize = audioCtx.sampleRate * 2.5;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = buffer.getChannelData(0);

        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }

        const whiteNoise = audioCtx.createBufferSource();
        whiteNoise.buffer = buffer;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(800, audioCtx.currentTime);
        filter.Q.setValueAtTime(1.0, audioCtx.currentTime);

        const gainNode = audioCtx.createGain();
        gainNode.gain.setValueAtTime(0.01, audioCtx.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.25, audioCtx.currentTime + 0.3);
        gainNode.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 1.5);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 2.5);

        whiteNoise.connect(filter);
        filter.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        whiteNoise.start();
        whiteNoise.stop(audioCtx.currentTime + 2.5);
      } catch (e) {}
    }

    function startMicrophoneBlowDetection() {
      if (isMicListening || candleBlownOut) return;
      
      navigator.mediaDevices.getUserMedia({ audio: true, video: false })
        .then(stream => {
          micStream = stream;
          isMicListening = true;
          initAudioContext();
          
          const source = audioCtx.createMediaStreamSource(stream);
          analyser = audioCtx.createAnalyser();
          analyser.fftSize = 512;
          source.connect(analyser);

          const dataArray = new Uint8Array(analyser.frequencyBinCount);

          function checkBlow() {
            if (candleBlownOut || !isMicListening) return;
            analyser.getByteFrequencyData(dataArray);
            let sum = 0;
            for (let i = 0; i < dataArray.length; i++) {
              sum += dataArray[i];
            }
            let average = sum / dataArray.length;

            if (average > 35) {
              blowOutCandle();
              stopMicrophoneBlowDetection();
              return;
            }
            requestAnimationFrame(checkBlow);
          }
          checkBlow();
        })
        .catch(err => {
          console.log("Microphone access not available or denied:", err);
        });
    }

    function stopMicrophoneBlowDetection() {
      isMicListening = false;
      if (micStream) {
        micStream.getTracks().forEach(track => track.stop());
        micStream = null;
      }
    }
  </script>

