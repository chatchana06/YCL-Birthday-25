          const firstMetDate = new Date('2025-08-27T00:00:00').getTime();

          function updateReceiptTimer() {
            if (!timerEl) return;
            const now = new Date().getTime();
            const diff = Math.max(0, now - firstMetDate);

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            timerEl.textContent = days + ' Days ' + hours + 'h ' + minutes + 'm ' + seconds + 's';
          }

          updateReceiptTimer();
          setInterval(updateReceiptTimer, 1000);
        })();
